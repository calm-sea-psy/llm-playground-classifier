{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=classifier;Username=classifier;Password=change-me"
  },
  "Database": {
    "MigrateOnStartup": true
  },

  "Features": {
    "Text":       { "Enabled": true,  "ShowInUi": true  },
    "Image":      { "Enabled": true,  "ShowInUi": true  },
    "Multimodal": { "Enabled": true,  "ShowInUi": true  }
  },

  "Storage": {
    "UploadRoot": "../../data/uploads",
    "MaxUploadMb": 20
  },
  "Jobs": {
    "// QueueCapacity": "모델 비교 실험은 문서 N × 조합 M 건을 한 번에 넣으므로 여유 있게",
    "QueueCapacity": 500
  },

  "Ocr": {
    "BaseUrl": "http://127.0.0.1:8001",
    "Engine": "paddleocr",
    "Engines": [ "paddleocr", "ppstructure" ],
    "TimeoutSeconds": 30,
    "Retries": 1
  },
  "Llm": {
    "Provider": "ollama",
    "BaseUrl": "http://127.0.0.1:11434",
    "// Models": "qwen3-vl:8b 는 추론형(thinking) 설치본이라 이미지에서 추론을 반복함 ➔ 답만 내는 instruct 판을 함께 비교 (2차-3b)",
    "Models": [ "gemma4:12b", "qwen3-vl:8b", "qwen3-vl:8b-instruct" ],
    "// DefaultModel": "5단계 모델 선정 결과 (docs/model_selection.md)",
    "DefaultModel": "gemma4:12b",
    "ContextLength": 16384,
    "Think": false,
    "KeepAlive": "10m",
    "// UnloadBeforeOcr": "Never | Always | LargeImages (5MP 초과 이미지만 OCR 전에 LLM 을 GPU 에서 내림, doc/develop.md 6단계 측정)",
    "UnloadBeforeOcr": "LargeImages",
    "UnloadAboveMegapixels": 5.0,
    "TimeoutSeconds": 300
  },
  "Cnn": {
    "BaseUrl": "http://127.0.0.1:8002",
    "TimeoutSeconds": 30,
    "PneumoniaEngine": "pneumonia",
    "FindingsEngine": "xrv"
  },
  "Image": {
    "// Population": "기본 대상 adult | pediatric. 폐렴 판단 출처: 성인 = xrv 경화, 소아 = pneumonia 엔진 (2차-1b)",
    "Population": "adult",
    "// VlmSeesCnn": "VLM 에 CNN 결과를 보여 줄지. 끄면 두 판단을 독립적으로 받아 교차 검증 (ImageSettings 참고)",
    "VlmReport": true,
    "VlmSeesCnn": false,
    "VlmMaxImageSide": 1024
  },
  "Eval": {
    "KorieLabels": "../../data/verify/korie_fields_labels.csv"
  },
  "Pipeline": {
    "// FallbackConfidence": "OCR 평균 신뢰도가 이보다 낮으면 VLM 폴백. 0.6 은 KORIE·AI Hub 모두 발동한 적이 없어 0.9 로 (doc/develop.md A 측정). DB 기본 설정이 없을 때의 초기값",
    "FallbackConfidence": 0.9,
    "AmountsAsString": false,
    "VlmMaxImageSide": 1600,
    "ClassifyMaxChars": 1500,
    "// Extraction": "legacy | engine (Digitizer.Engine + packs/<문서 종류>). DB 기본 설정이 없을 때의 초기값. KORIE 150장에서 legacy 와 결과 같아 engine (4차 통합 C, doc/develop.md)",
    "Extraction": "engine",
    "PacksRoot": "../../packs"
  }
}
