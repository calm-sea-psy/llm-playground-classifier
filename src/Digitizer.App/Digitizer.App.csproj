<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 문서 전산화 배포용 프로그램 (exe). 평가 도구(Api)는 참조하지 않고 Engine + 합격한 팩만 씀 (doc: docs/pack_reports.md) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Digitizer</AssemblyName>
    <!-- 설치 파일 이름 · 제어판 버전 (installer/build.ps1 이 읽음) -->
    <Version>0.1.0</Version>
    <Product>문서 전산화</Product>
    <RootNamespace>Digitizer.App</RootNamespace>
    <!-- 콘솔 창 없는 exe + 알림 영역 아이콘(WinForms). 작업 개체 P/Invoke(LibraryImport) -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CI(ubuntu)에서도 빌드만은 되게. 실행 · 설치 파일은 Windows 전용 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PacksRoot>$(MSBuildThisFileDirectory)..\..\packs\</PacksRoot>
    <ClientAppDir>$(MSBuildThisFileDirectory)ClientApp\</ClientAppDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**;ClientApp\dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 화면 소스(package.json · tsconfig 등)가 출력 · 게시 폴더에 섞이지 않게 -->
  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Digitizer.Engine\Digitizer.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!--
    합격 표시(type.json 의 "release")가 있는 팩만 출력 · 게시 폴더의 packs\ 로 복사.
    측정하지 않은 팩(상업송장 · 보험 청구서 등)은 빌드 로그에 남기고 넣지 않음. 앱도 시작할 때 release 를 다시 확인
  -->
  <Target Name="IncludeReleasedPacks" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_PackType Include="$(PacksRoot)*\type.json" />
      <_PackType Update="@(_PackType)" PackName="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))" Released="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '&quot;release&quot;\s*:'))" />
      <_ReleasedPackDir Include="@(_PackType->'%(RootDir)%(Directory)')" Condition="'%(Released)' == 'True'" />
      <_SkippedPack Include="@(_PackType->'%(PackName)')" Condition="'%(Released)' != 'True'" />
      <_ReleasedPackFile Include="%(_ReleasedPackDir.Identity)type.json;%(_ReleasedPackDir.Identity)*.md" />
      <Content Include="@(_ReleasedPackFile)" Link="packs\$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Message Importance="high" Text="합격 표시가 없어 exe 에 넣지 않는 팩: @(_SkippedPack, ', ')" Condition="'@(_SkippedPack)' != ''" />
  </Target>

  <!--
    화면(ClientApp, Vite + React): 소스가 dist 보다 새로우면 npm 으로 빌드하고, dist 를 출력 · 게시 폴더의 wwwroot 로 복사.
    Node.js 가 없는 곳에서 서버만 빌드하려면 -p:SkipClientApp=true (화면 없이 API 만)
  -->
  <ItemGroup>
    <_ClientAppInput Include="ClientApp\src\**;ClientApp\index.html;ClientApp\package.json;ClientApp\vite.config.ts;ClientApp\public\**" />
  </ItemGroup>
  <Target Name="BuildClientApp" BeforeTargets="AssignTargetPaths" Condition="'$(SkipClientApp)' != 'true'"
          Inputs="@(_ClientAppInput)" Outputs="$(ClientAppDir)dist\index.html">
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppDir)" Condition="!Exists('$(ClientAppDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDir)" />
  </Target>
  <Target Name="IncludeClientApp" AfterTargets="BuildClientApp" BeforeTargets="AssignTargetPaths" Condition="'$(SkipClientApp)' != 'true'">
    <ItemGroup>
      <_ClientAppFile Include="$(ClientAppDir)dist\**" />
      <Content Include="@(_ClientAppFile)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
