{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "// RepoRoot": "ContentRoot(src/Monitor) 기준. Windows 서비스로 실행하면 ContentRoot 가 bin 폴더가 되므로 절대 경로로 지정",
    "RepoRoot": "../..",
    "IntervalSeconds": 10,
    "TimeoutSeconds": 3,
    "FailuresToDown": 3,
    "FailureRecheckSeconds": 3,
    "Restart": {
      "InitialBackoffSeconds": 5,
      "MaxBackoffSeconds": 120,
      "MaxAttempts": 5,
      "WindowMinutes": 10
    },
    "Webhook": {
      "// Url": "Discord/Slack 웹훅 URL (비어 있으면 끔). 비밀 값이라 appsettings.Development.json 이나 환경 변수 Monitor__Webhook__Url 로",
      "Url": ""
    },
    "KillChildrenOnExit": false
  }
}
