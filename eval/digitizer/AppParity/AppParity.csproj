<Project Sdk="Microsoft.NET.Sdk">

  <!-- 4차-exe 6-1 · 6-3: 설치판(exe) 대기열로 처리한 결과를 평가 도구 측정 결과와 대조 (결과 DB 를 직접 읽음) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Digitizer.Engine\Digitizer.Engine.csproj" />
  </ItemGroup>

</Project>
